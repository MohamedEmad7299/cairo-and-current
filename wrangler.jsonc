{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cairo-and-current-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "observability": {"enabled": false},
  "vars": {
    "ALLOWED_ORIGIN": "https://mohamedemad7299.github.io",
    "PUBLIC_SITE_URL": "https://mohamedemad7299.github.io/cairo-and-current/"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cairo-and-current",
    "database_id": "e6845e39-3647-4198-bc18-d47b7af86d14",
    "migrations_dir": "migrations"
  }]
}

